
MONGODB_URI=

MONGODB_AUTH_DB=

GOOGLE_CLIENT_ID=

JWT_SECRET=

PORT=

# Superadmin — set your own email/password, then from backend folder run:
#   npm run migrate:superadmin
SUPERADMIN_EMAIL=your-email@example.com
SUPERADMIN_PASSWORD=your-secure-password

DARAZ_APP_KEY=your_app_key
DARAZ_APP_SECRET=your_secret
DARAZ_REDIRECT_URI=https://abc123.ngrok-free.app/api/daraz/callback
# Optional: Daraz leaf category id for new listings when product type cannot be matched
# DARAZ_DEFAULT_CATEGORY_ID=10002871

# Google Gemini — AI product listings (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email alerts when product stock reaches 0 (sent to tenant signup email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="UniSell Alerts <your@gmail.com>"